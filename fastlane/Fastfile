# בנייה והעלאה של "מונה" ל-TestFlight מתוך GitHub Actions (macOS), בלי Mac אצל לו.
# זיהוי מול Apple: מפתח App Store Connect API (ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_P8).
# תעודות ופרופילים: fastlane match, נשמרים מוצפנים בריפו פרטי (MATCH_GIT_URL / MATCH_GIT_TOKEN / MATCH_PASSWORD).
default_platform(:ios)

APP_ID = "com.loukorek.mone"
APP_NAME = "מונה"

platform :ios do
  desc "מוודא שה-App ID קיים עם Sign in with Apple, ושיש רשומת אפליקציה ב-App Store Connect"
  lane :ensure_app do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"], is_key_content_base64: true
    )
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(key_id: api_key[:key_id], issuer_id: api_key[:issuer_id], key: api_key[:key])
    bundle = Spaceship::ConnectAPI::BundleId.all(filter: { identifier: APP_ID }).find { |b| b.identifier == APP_ID }
    unless bundle
      bundle = Spaceship::ConnectAPI::BundleId.create(name: "Mone", platform: "IOS", identifier: APP_ID)
      UI.success("נוצר App ID #{APP_ID}")
    end
    caps = bundle.get_capabilities.map(&:capability_type) rescue []
    unless caps.include?("SIGN_IN_WITH_APPLE")
      Spaceship::ConnectAPI::BundleIdCapability.create(bundle_id_id: bundle.id, capability_type: "SIGN_IN_WITH_APPLE")
      UI.success("הופעל Sign in with Apple")
    end
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    unless app
      Spaceship::ConnectAPI::App.create(name: APP_NAME, version_string: "1.0", sku: "mone-taxi", primary_locale: "he", bundle_id: APP_ID, platforms: ["IOS"])
      UI.success("נוצרה רשומת אפליקציה ב-App Store Connect")
    end
  end

  desc "בונה IPA חתום ומעלה ל-TestFlight"
  lane :beta do
    setup_ci
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"], is_key_content_base64: true
    )
    ensure_app
    match(
      type: "appstore", app_identifier: APP_ID, api_key: api_key, readonly: false,
      git_url: ENV["MATCH_GIT_URL"], git_basic_authorization: Base64.strict_encode64("x-access-token:#{ENV['MATCH_GIT_TOKEN']}"),
      platform: "ios"
    )
    profile_name = ENV["sigh_#{APP_ID}_appstore_profile-name"]
    update_code_signing_settings(
      path: "ios/App/App.xcodeproj", use_automatic_signing: false, team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "Apple Distribution", profile_name: profile_name, bundle_identifier: APP_ID, targets: ["App"]
    )
    build_app(
      workspace: "ios/App/App.xcworkspace", scheme: "App", configuration: "Release",
      export_method: "app-store", output_directory: "out", output_name: "mone.ipa"
    )
    upload_to_testflight(api_key: api_key, ipa: "out/mone.ipa", skip_waiting_for_build_processing: true, changelog: "בנייה אוטומטית מ-GitHub Actions")
  end
end
